		uart0 {

			uart0m0-xfer {
				rockchip,pins = <0x04 0x17 0x01 0x11 0x04 0x18 0x01 0x11>;
				phandle = <0x16>;
			};
		};

		uart1 {
		};

		uart2 {

			uart2m0-xfer {
				rockchip,pins = <0x03 0x00 0x01 0x11 0x03 0x01 0x01 0x11>;
				phandle = <0x93>;
			};

			uart2m0-ctsn {
				rockchip,pins = <0x03 0x03 0x01 0x0d>;
				phandle = <0x94>;
			};

			uart2m0-rtsn {
				rockchip,pins = <0x03 0x02 0x01 0x0d>;
				phandle = <0x95>;
			};

			uart2m0-gpios {
				rockchip,pins = <0x03 0x02 0x00 0x0d>;
				phandle = <0x9b>;
			};
		};

		uart3 {
		};

		uart4 {
		};

		uart5 {
		};

		uart6 {
		};

		uart7 {
		};

		leds {

			led-net-red {
				rockchip,pins = <0x04 0x0f 0x00 0x0d>;
				phandle = <0x5d>;
			};

			led-net-green {
				rockchip,pins = <0x04 0x10 0x00 0x0d>;
				phandle = <0x5e>;
			};

			led-pwr-red {
				rockchip,pins = <0x04 0x0b 0x00 0x0d>;
				phandle = <0x5f>;
			};

			led-pwr-green {
				rockchip,pins = <0x04 0x11 0x00 0x0d>;
				phandle = <0x60>;
			};
		};

		sdio-pwrseq {

			wifi-enable-h {
				rockchip,pins = <0x03 0x0a 0x00 0x0d>;
				phandle = <0x9c>;
			};
		};

		wireless-wlan {

			wifi-host-wake-irq {
				rockchip,pins = <0x03 0x0b 0x00 0x11>;
				phandle = <0x9d>;
			};

			wifi-reset {
				rockchip,pins = <0x03 0x0c 0x00 0x9e>;
				phandle = <0x9f>;
			};
		};
	};

	psci {
		compatible = "arm,psci-1.0\0arm,psci-0.2";
		method = "smc";
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		shmem@10f000 {
			compatible = "arm,scmi-shmem";
			reg = <0x00 0x10f000 0x00 0x100>;
			no-map;
			phandle = <0x09>;
		};

		ramoops@118000 {
			compatible = "ramoops";
			reg = <0x00 0x118000 0x00 0xd8000>;
			console-size = <0x80000>;
			ftrace-size = <0x00>;
			pmsg-size = <0x30000>;
			record-size = <0x14000>;
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0xf08 0x01 0x0e 0xf08 0x01 0x0b 0xf08 0x01 0x0a 0xf08>;
	};

	clock-xin24m {
		compatible = "fixed-clock";
		clock-frequency = <0x16e3600>;
		clock-output-names = "xin24m";
		#clock-cells = <0x00>;
		phandle = <0x13>;
	};

	clock-gmac50m {
		compatible = "fixed-clock";
		clock-frequency = <0x2faf080>;
		clock-output-names = "gmac0";
		#clock-cells = <0x00>;
		phandle = <0x14>;
	};

	soc {
		compatible = "simple-bus";
		ranges;
		#address-cells = <0x02>;
		#size-cells = <0x02>;

		interrupt-controller@fed01000 {
			compatible = "arm,gic-400";
			reg = <0x00 0xfed01000 0x00 0x1000 0x00 0xfed02000 0x00 0x2000 0x00 0xfed04000 0x00 0x2000 0x00 0xfed06000 0x00 0x2000>;
			interrupts = <0x01 0x09 0xf08>;
			interrupt-controller;
			#address-cells = <0x00>;
			#interrupt-cells = <0x03>;
			phandle = <0x01>;
		};

		qos@ff200000 {
			compatible = "rockchip,rk3528-qos\0syscon";
			reg = <0x00 0xff200000 0x00 0x20>;
		};

		qos@ff200080 {
			compatible = "rockchip,rk3528-qos\0syscon";
			reg = <0x00 0xff200080 0x00 0x20>;
		};

		qos@ff200100 {
