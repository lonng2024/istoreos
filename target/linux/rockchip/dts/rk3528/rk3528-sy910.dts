/dts-v1/;

/ {
	compatible = "xuanying,sy910\0rockchip,rk3528";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "SY910 (iStoreOS)";

	aliases {
		gpio0 = "/pinctrl/gpio@ff610000";
		gpio1 = "/pinctrl/gpio@ffaf0000";
		gpio2 = "/pinctrl/gpio@ffb00000";
		gpio3 = "/pinctrl/gpio@ffb10000";
		gpio4 = "/pinctrl/gpio@ffb20000";
		ethernet0 = "/soc/ethernet@ffbd0000";
		mmc0 = "/soc/mmc@ffc30000";
		mmc1 = "/soc/mmc@ffbf0000";
		led-boot = "/leds/led-pwr-green";
		led-failsafe = "/leds/led-pwr-green";
		led-running = "/leds/led-pwr-green";
		led-upgrade = "/leds/led-pwr-green";
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x02>;
				};

				core1 {
					cpu = <0x03>;
				};

				core2 {
					cpu = <0x04>;
				};

				core3 {
					cpu = <0x05>;
				};
			};
		};

		cpu@0 {
			compatible = "arm,cortex-a53";
			reg = <0x00>;
			device_type = "cpu";
			enable-method = "psci";
			clocks = <0x06 0x15>;
			operating-points-v2 = <0x07>;
			#cooling-cells = <0x02>;
			cpu-supply = <0x08>;
			phandle = <0x02>;
		};

		cpu@1 {
			compatible = "arm,cortex-a53";
			reg = <0x01>;
			device_type = "cpu";
			enable-method = "psci";
			clocks = <0x06 0x15>;
			operating-points-v2 = <0x07>;
			#cooling-cells = <0x02>;
			cpu-supply = <0x08>;
			phandle = <0x03>;
		};

		cpu@2 {
			compatible = "arm,cortex-a53";
			reg = <0x02>;
			device_type = "cpu";
			enable-method = "psci";
			clocks = <0x06 0x15>;
			operating-points-v2 = <0x07>;
			#cooling-cells = <0x02>;
			cpu-supply = <0x08>;
			phandle = <0x04>;
		};

		cpu@3 {
			compatible = "arm,cortex-a53";
			reg = <0x03>;
			device_type = "cpu";
			enable-method = "psci";
			clocks = <0x06 0x15>;
			operating-points-v2 = <0x07>;
			#cooling-cells = <0x02>;
			cpu-supply = <0x08>;
			phandle = <0x05>;
		};
	};

	firmware {

		scmi {
			compatible = "arm,scmi-smc";
			arm,smc-id = <0x82000010>;
			shmem = <0x09>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			protocol@14 {
				reg = <0x14>;
				#clock-cells = <0x01>;
				phandle = <0x06>;
			};
		};
	};

	pinctrl {
		compatible = "rockchip,rk3528-pinctrl";
		rockchip,grf = <0x0a>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0x0c>;

		gpio@ff610000 {
			compatible = "rockchip,gpio-bank";
			reg = <0x00 0xff610000 0x00 0x200>;
			clocks = <0x0b 0x172 0x0b 0x173>;
			interrupts = <0x00 0x47 0x04>;
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <0x0c 0x00 0x00 0x20>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
		};

		gpio@ffaf0000 {
			compatible = "rockchip,gpio-bank";
			reg = <0x00 0xffaf0000 0x00 0x200>;
			clocks = <0x0b 0x91 0x0b 0x92>;
			interrupts = <0x00 0x49 0x04>;
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <0x0c 0x00 0x20 0x20>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
		};

		gpio@ffb00000 {
			compatible = "rockchip,gpio-bank";
			reg = <0x00 0xffb00000 0x00 0x200>;
			clocks = <0x0b 0x124 0x0b 0x125>;
			interrupts = <0x00 0x4b 0x04>;
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <0x0c 0x00 0x40 0x20>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
		};

		gpio@ffb10000 {
			compatible = "rockchip,gpio-bank";
			reg = <0x00 0xffb10000 0x00 0x200>;
			clocks = <0x0b 0x9b 0x0b 0x9c>;
			interrupts = <0x00 0x4c 0x04>;
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <0x0c 0x00 0x60 0x20>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x92>;
		};

		gpio@ffb20000 {
			compatible = "rockchip,gpio-bank";
			reg = <0x00 0xffb20000 0x00 0x200>;
			clocks = <0x0b 0xe4 0x0b 0xe5>;
			interrupts = <0x00 0x4e 0x04>;
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <0x0c 0x00 0x80 0x20>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x28>;
		};

		pcfg-pull-up {
			bias-pull-up;
			phandle = <0x11>;
		};

		pcfg-pull-none {
			bias-disable;
			phandle = <0x0d>;
		};

		pcfg-pull-none-drv-level-0 {
			bias-disable;
			drive-strength = <0x00>;
			phandle = <0x12>;
		};

		pcfg-pull-none-drv-level-2 {
			bias-disable;
			drive-strength = <0x02>;
			phandle = <0x0f>;
		};

		pcfg-pull-up-drv-level-2 {
			bias-pull-up;
			drive-strength = <0x02>;
			phandle = <0x0e>;
		};

		pcfg-pull-none-smt {
			bias-disable;
			input-schmitt-enable;
			phandle = <0x10>;
		};

		pcfg-output-high {
			output-high;
			phandle = <0x9e>;
		};

		arm {
		};

		clk {
		};

		emmc {

			emmc-bus8 {
				rockchip,pins = <0x01 0x14 0x01 0x0e 0x01 0x15 0x01 0x0e 0x01 0x16 0x01 0x0e 0x01 0x17 0x01 0x0e 0x01 0x18 0x01 0x0e 0x01 0x19 0x01 0x0e 0x01 0x1a 0x01 0x0e 0x01 0x1b 0x01 0x0e>;
				phandle = <0x2f>;
			};

			emmc-clk {
				rockchip,pins = <0x01 0x1d 0x01 0x0e>;
				phandle = <0x30>;
			};

			emmc-cmd {
				rockchip,pins = <0x01 0x1c 0x01 0x0e>;
				phandle = <0x31>;
			};

			emmc-strb {
				rockchip,pins = <0x01 0x1f 0x01 0x0d>;
				phandle = <0x32>;
			};
		};

		eth {
		};

		fephy {

			fephym0-led_link {
				rockchip,pins = <0x04 0x10 0x02 0x0d>;
				phandle = <0x22>;
			};

			fephym0-led_spd {
				rockchip,pins = <0x04 0x0f 0x02 0x0d>;
				phandle = <0x23>;
			};
		};

		fspi {
		};

		gpu {
		};

		hdmi {
		};

		hsm {
		};

		i2c0 {
		};

		i2c1 {
		};

		i2c2 {

			i2c2m1-xfer {
				rockchip,pins = <0x01 0x05 0x03 0x10 0x01 0x06 0x03 0x10>;
				phandle = <0x17>;
			};
		};

		i2c3 {
		};

		i2c4 {

			i2c4-xfer {
				rockchip,pins = <0x02 0x00 0x04 0x10 0x02 0x01 0x04 0x10>;
				phandle = <0x18>;
			};
		};

		i2c5 {
		};

		i2c6 {
		};

		i2c7 {

			i2c7-xfer {
				rockchip,pins = <0x02 0x05 0x04 0x10 0x02 0x06 0x04 0x10>;
				phandle = <0x19>;
			};
		};

		i2s0 {
		};

		i2s1 {
		};

		jtag {
		};

		pcie {

			rtl8111-isolate {
				rockchip,pins = <0x04 0x06 0x00 0x11>;
				phandle = <0x44>;
			};
		};

		pdm {
		};

		pmu {
		};

		pwm0 {
		};

		pwm1 {

			pwm1m0-pins {
				rockchip,pins = <0x04 0x14 0x01 0x12>;
				phandle = <0x1a>;
			};
		};

		pwm2 {

			pwm2m0-pins {
				rockchip,pins = <0x04 0x15 0x01 0x12>;
				phandle = <0x1b>;
			};
		};

		pwm3 {
		};

		pwm4 {
