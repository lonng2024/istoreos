			interrupts = <0x00 0x6a 0x04>;
			clocks = <0x0b 0xfc 0x0b 0xfb 0x0b 0xfd>;
			clock-names = "aclk\0hclk\0sclk";
			rockchip,normal-rates = <0x1443fd00 0x00 0x1443fd00>;
			assigned-clocks = <0x0b 0xfc 0x0b 0xfd>;
			assigned-clock-rates = <0x1443fd00 0x1443fd00>;
			resets = <0x0b 0x9e 0x0b 0x9d 0x0b 0x9f>;
			reset-names = "shared_rst_a\0shared_rst_h\0shared_rst_s";
			rockchip,srv = <0x49>;
			rockchip,grf = <0x1e>;
			rockchip,grf-mem-offset = <0xe0>;
			rockchip,grf-mem-values = <0xf0040000 0xf004f004>;
			rockchip,taskqueue-node = <0x03>;
			rockchip,resetgroup-node = <0x03>;
			rockchip,disable-auto-freq;
			iommus = <0x4f>;
			status = "okay";
		};

		jpegd@ff870000 {
			compatible = "rockchip,rkv-jpeg-decoder-v1";
			reg = <0x00 0xff870000 0x00 0x400>;
			interrupts = <0x00 0x6b 0x04>;
			clocks = <0x0b 0x114 0x0b 0x115>;
			clock-names = "aclk_vcodec\0hclk_vcodec";
			rockchip,normal-rates = <0x1443fd00 0x00>;
			assigned-clocks = <0x0b 0x114>;
			assigned-clock-rates = <0x1443fd00>;
			rockchip,disable-auto-freq;
			resets = <0x0b 0xb1 0x0b 0xb2>;
			reset-names = "video_a\0video_h";
			iommus = <0x50>;
			rockchip,srv = <0x49>;
			rockchip,taskqueue-node = <0x04>;
			rockchip,resetgroup-node = <0x04>;
			status = "okay";
		};

		iommu@ff870480 {
			compatible = "rockchip,rk3528-iommu\0rockchip,rk3568-iommu\0rockchip,iommu-v2";
			reg = <0x00 0xff870480 0x00 0x40>;
			interrupts = <0x00 0x6c 0x04>;
			interrupt-names = "jpegd_mmu";
			clock-names = "aclk\0iface";
			clocks = <0x0b 0x114 0x0b 0x115>;
			#iommu-cells = <0x00>;
			rockchip,shootdown-entire;
			status = "okay";
			phandle = <0x50>;
		};

		syscon@ff310000 {
			compatible = "rockchip,rk3528-gpu-grf\0syscon";
			reg = <0x00 0xff310000 0x00 0x10000>;
			phandle = <0x52>;
		};

		gpu@ff700000 {
			compatible = "arm,mali-450";
			reg = <0x00 0xff700000 0x00 0x40000>;
			interrupts = <0x00 0x58 0x04 0x00 0x59 0x04 0x00 0x56 0x04 0x00 0x5c 0x04 0x00 0x5d 0x04 0x00 0x5a 0x04 0x00 0x5b 0x04>;
			interrupt-names = "Mali_GP_IRQ\0Mali_GP_MMU_IRQ\0IRQPP\0Mali_PP0_IRQ\0Mali_PP0_MMU_IRQ\0Mali_PP1_IRQ\0Mali_PP1_MMU_IRQ";
			clocks = <0x06 0x16 0x0b 0xd0 0x0b 0xcb>;
			clock-names = "clk_mali\0aclk_gpu_mali\0pclk_gpu";
			assigned-clocks = <0x06 0x16>;
			assigned-clock-rates = <0x11e1a300>;
			operating-points-v2 = <0x51>;
			#cooling-cells = <0x02>;
			rockchip,grf = <0x52>;
			status = "okay";
			phandle = <0x5a>;

			power-model {
				compatible = "simple-power-model";
				leakage-range = <0x01 0x03>;
				ls = <0xffffc2d6 0x1071a 0x00>;
				static-coefficient = <0x2710>;
				dynamic-coefficient = <0x2d4>;
				ts = <0x302a42 0x1d55a 0xfffff636 0x27>;
				thermal-zone = "soc-thermal";
			};
		};

		gpu-opp-table {
			compatible = "operating-points-v2";
			mbist-vmin = <0xc96a8 0xe1d48>;
			nvmem-cells = <0x53 0x54 0x55>;
			nvmem-cell-names = "leakage\0opp-info\0mbist-vmin";
			rockchip,pvtm-voltage-sel = <0x00 0x2ee 0x00 0x2ef 0x302 0x01 0x303 0x316 0x02 0x317 0x32a 0x03 0x32b 0x33e 0x04 0x33f 0x352 0x05 0x353 0x366 0x06 0x367 0x37a 0x07 0x37b 0x270f 0x08>;
			rockchip,pvtm-pvtpll;
			rockchip,pvtm-offset = <0x18>;
			rockchip,pvtm-sample-time = <0x44c>;
			rockchip,pvtm-freq = "\0\f5";
			rockchip,pvtm-volt = <0xdbba0>;
			rockchip,pvtm-ref-temp = <0x28>;
			rockchip,pvtm-temp-prop = <0x00 0x00>;
			rockchip,pvtm-thermal-zone = "soc-thermal";
			rockchip,grf = <0x52>;
			rockchip,temp-hysteresis = <0x1388>;
			rockchip,low-temp = <0x2710>;
			rockchip,low-temp-min-volt = <0xdbba0>;
			phandle = <0x51>;

			opp-300000000 {
				opp-hz = <0x00 0x11e1a300>;
				opp-microvolt = <0xd59f8 0xd59f8 0xf4240>;
				opp-microvolt-L5 = <0xcf850 0xcf850 0xf4240>;
				opp-microvolt-L6 = <0xcc77c 0xcc77c 0xf4240>;
				opp-microvolt-L7 = <0xc96a8 0xc96a8 0xf4240>;
				opp-microvolt-L8 = <0xc96a8 0xc96a8 0xf4240>;
			};

			opp-500000000 {
				opp-hz = <0x00 0x1dcd6500>;
				opp-microvolt = <0xd59f8 0xd59f8 0xf4240>;
				opp-microvolt-L5 = <0xcf850 0xcf850 0xf4240>;
				opp-microvolt-L6 = <0xcc77c 0xcc77c 0xf4240>;
				opp-microvolt-L7 = <0xc96a8 0xc96a8 0xf4240>;
				opp-microvolt-L8 = <0xc96a8 0xc96a8 0xf4240>;
			};

			opp-600000000 {
				opp-hz = <0x00 0x23c34600>;
				opp-microvolt = <0xd59f8 0xd59f8 0xf4240>;
				opp-microvolt-L5 = <0xcf850 0xcf850 0xf4240>;
				opp-microvolt-L6 = <0xcc77c 0xcc77c 0xf4240>;
				opp-microvolt-L7 = <0xc96a8 0xc96a8 0xf4240>;
				opp-microvolt-L8 = <0xc96a8 0xc96a8 0xf4240>;
			};

			opp-700000000 {
				opp-hz = <0x00 0x29b92700>;
				opp-microvolt = <0xdbba0 0xdbba0 0xf4240>;
				opp-microvolt-L1 = <0xd8acc 0xd8acc 0xf4240>;
				opp-microvolt-L2 = <0xd59f8 0xd59f8 0xf4240>;
				opp-microvolt-L3 = <0xd59f8 0xd59f8 0xf4240>;
				opp-microvolt-L4 = <0xd59f8 0xd59f8 0xf4240>;
				opp-microvolt-L5 = <0xcf850 0xcf850 0xf4240>;
				opp-microvolt-L6 = <0xcc77c 0xcc77c 0xf4240>;
				opp-microvolt-L7 = <0xc96a8 0xc96a8 0xf4240>;
				opp-microvolt-L8 = <0xc96a8 0xc96a8 0xf4240>;
				clock-latency-ns = <0x9c40>;
			};

			opp-800000000 {
				opp-hz = <0x00 0x2faf0800>;
				opp-microvolt = <0xe7ef0 0xe7ef0 0xf4240>;
				opp-microvolt-L1 = <0xe4e1c 0xe4e1c 0xf4240>;
				opp-microvolt-L2 = <0xe1d48 0xe1d48 0xf4240>;
				opp-microvolt-L3 = <0xdec74 0xdec74 0xf4240>;
				opp-microvolt-L4 = <0xdbba0 0xdbba0 0xf4240>;
				opp-microvolt-L5 = <0xd8acc 0xd8acc 0xf4240>;
				opp-microvolt-L6 = <0xd59f8 0xd59f8 0xf4240>;
				opp-microvolt-L7 = <0xd2924 0xd2924 0xf4240>;
				opp-microvolt-L8 = <0xcf850 0xcf850 0xf4240>;
				clock-latency-ns = <0x9c40>;
			};
		};

		gpu-bus {
			compatible = "rockchip,rk3528-bus";
			rockchip,busfreq-policy = "clkfreq";
			clocks = <0x06 0x16>;
			clock-names = "bus";
			operating-points-v2 = <0x56>;
			status = "disabled";
		};

		gpu-bus-opp-table {
			compatible = "operating-points-v2";
			nvmem-cells = <0x57>;
			nvmem-cell-names = "leakage";
			rockchip,leakage-voltage-sel = <0x01 0x16 0x00 0x17 0xfe 0x01>;
			phandle = <0x56>;

			opp-700000000 {
				opp-hz = <0x00 0x29b92700>;
				opp-microvolt = <0xcf850 0xcf850 0xf4240>;
			};

			opp-800000000 {
				opp-hz = <0x00 0x2faf0800>;
				opp-microvolt = <0xd59f8 0xd59f8 0xf4240>;
				opp-microvolt-L1 = <0xcf850 0xcf850 0xf4240>;
			};
		};
	};

	rockchip-system-monitor {
		compatible = "rockchip,system-monitor";
		rockchip,thermal-zone = "soc-thermal";
		rockchip,polling-delay = <0xc8>;
		rockchip,temp-hysteresis = <0x1388>;
		rockchip,offline-cpu-temp = <0x19a28>;
		rockchip,temp-offline-cpus = "2-3";
	};

	opp-table-cpu {
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x07>;

		opp-408000000 {
			opp-hz = <0x00 0x18519600>;
			opp-microvolt = <0xd59f8 0xd59f8 0x10c8e0>;
			clock-latency-ns = <0x9c40>;
			opp-suspend;
		};

		opp-600000000 {
			opp-hz = <0x00 0x23c34600>;
			opp-microvolt = <0xd59f8 0xd59f8 0x10c8e0>;
			clock-latency-ns = <0x9c40>;
		};

		opp-816000000 {
			opp-hz = <0x00 0x30a32c00>;
			opp-microvolt = <0xd59f8 0xd59f8 0x10c8e0>;
			clock-latency-ns = <0x9c40>;
		};

		opp-1008000000 {
			opp-hz = <0x00 0x3c14dc00>;
			opp-microvolt = <0xd59f8 0xd59f8 0x10c8e0>;
			clock-latency-ns = <0x9c40>;
		};

		opp-1200000000 {
			opp-hz = <0x00 0x47868c00>;
			opp-microvolt = <0xdbba0 0xdbba0 0x10c8e0>;
			clock-latency-ns = <0x9c40>;
		};

		opp-1416000000 {
			opp-hz = <0x00 0x54667200>;
			opp-microvolt = <0xe1d48 0xe1d48 0x10c8e0>;
			clock-latency-ns = <0x9c40>;
		};

		opp-1608000000 {
			opp-hz = <0x00 0x5fd82200>;
			opp-microvolt = <0xee098 0xee098 0x10c8e0>;
			clock-latency-ns = <0x9c40>;
		};

		opp-1800000000 {
			opp-hz = <0x00 0x6b49d200>;
			opp-microvolt = <0xfd4bc 0xfd4bc 0x10c8e0>;
			clock-latency-ns = <0x9c40>;
		};

		opp-2016000000 {
			opp-hz = <0x00 0x7829b800>;
			opp-microvolt = <0x10c8e0 0x10c8e0 0x10c8e0>;
			clock-latency-ns = <0x9c40>;
		};
	};

	thermal-zones {

		soc-thermal {
			polling-delay-passive = <0x14>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0x58 0x00>;

			trips {

				trip-point-0 {
					temperature = <0x17318>;
					hysteresis = <0x7d0>;
					type = "passive";
				};

				trip-point-1 {
					temperature = <0x1adb0>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x59>;
				};

				soc-crit {
					temperature = <0x1d4c0>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};

			cooling-maps {

				map0 {
					trip = <0x59>;
					cooling-device = <0x02 0xffffffff 0xffffffff 0x03 0xffffffff 0xffffffff 0x04 0xffffffff 0xffffffff 0x05 0xffffffff 0xffffffff>;
				};

				map1 {
					trip = <0x59>;
					cooling-device = <0x5a 0xffffffff 0xffffffff>;
				};
			};
		};
	};

	chosen {
		stdout-path = "serial0:1500000n8";
	};

	vcc5v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		phandle = <0x41>;
	};

	vccio-sd {
		compatible = "regulator-gpio";
		regulator-name = "vccio_sd";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x325aa0>;
		gpios = <0x28 0x0e 0x00>;
		vin-supply = <0x41>;
		states = <0x1b7740 0x00 0x325aa0 0x01>;
		phandle = <0x3e>;
	};

	vdd-logic {
		compatible = "pwm-regulator";
		pwms = <0x5b 0x00 0x1388 0x01>;
		regulator-name = "vdd_logic";
		regulator-min-microvolt = <0xac1e8>;
		regulator-max-microvolt = <0xf59b0>;
		regulator-init-microvolt = <0xdbba0>;
		regulator-always-on;
		regulator-boot-on;
		regulator-ramp-delay = <0x1771>;
		regulator-settling-time-up-us = <0xfa>;
		pwm-supply = <0x41>;
		status = "okay";
	};

	vdd-cpu {
		compatible = "pwm-regulator";
		pwms = <0x5c 0x00 0x1388 0x01>;
		regulator-name = "vdd_cpu";
		regulator-min-microvolt = <0xb6210>;
		regulator-max-microvolt = <0x125368>;
		regulator-init-microvolt = <0xe8aa8>;
		regulator-always-on;
		regulator-boot-on;
		regulator-ramp-delay = <0x1771>;
		regulator-settling-time-up-us = <0x1f4>;
		pwm-supply = <0x41>;
		status = "okay";
		phandle = <0x08>;
	};

	vdd-0v9-s3 {
		compatible = "regulator-fixed";
		regulator-name = "vdd_0v9_s3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0xdbba0>;
		regulator-max-microvolt = <0xdbba0>;
		vin-supply = <0x41>;
	};

	vdd-1v8-s3 {
		compatible = "regulator-fixed";
		regulator-name = "vdd_1v8_s3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		vin-supply = <0x41>;
		phandle = <0x1c>;
	};

	vcc-3v3-s3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3_s3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		vin-supply = <0x41>;
		phandle = <0x33>;
	};

	vcc-sd {
		compatible = "regulator-fixed";
		gpio = <0x28 0x01 0x01>;
		regulator-name = "vcc_sd";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		vin-supply = <0x33>;
		phandle = <0x3f>;
	};

	/* UWE5621 电源控制 */
	sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		pinctrl-0 = <0x9c 0x9f>;
		reset-gpios = <0x92 0x0a 0x01>;
		phandle = <0x61>;
	};

	wireless-bluetooth {
		compatible = "bluetooth-platdata";
		uart_rts_gpios = <0x92 0x02 0x01>;
		pinctrl-names = "default\0rts_gpio";
		pinctrl-0 = <0x95>;
		pinctrl-1 = <0x9b>;
		BT,wake_host_irq = <0x92 0x0b 0x00>;
		status = "okay";
	};

	uwe-bsp {
		compatible = "unisoc,uwe_bsp";
		bt-reg-on = <0x92 0x12 0x00>;
		sdio-ext-int-gpio = <0x92 0x0b 0x00>;
		unisoc,btwf-file-name = "/lib/firmware/wcnmodem.bin";
		bt-wake-host;
		bt-wake-host-gpio = <0x92 0x11 0x00>;
		data-irq;
		blksz-512;
		keep-power-on;
		status = "okay";
	};
	sprd-wlan {
		compatible = "sprd,uwe5621-wifi";
		status = "okay";
	};

	sprd-mtty {
		compatible = "sprd,mtty";
		sprd,name = "ttyBT";
		status = "okay";
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <0x5d 0x5e 0x5f 0x60>;

		led-net-red {
			gpios = <0x28 0x0f 0x01>;
			label = "red:net";
			default-state = "off";
		};

		led-net-green {
			gpios = <0x28 0x10 0x01>;
			label = "green:net";
			default-state = "off";
		};

		led-pwr-red {
			gpios = <0x28 0x0b 0x01>;
			label = "red:pwr";
			default-state = "off";
		};

		led-pwr-green {
			gpios = <0x28 0x11 0x01>;
			label = "green:pwr";
			linux,default-trigger = "heartbeat";
			default-state = "on";
		};
	};
};
