		pwm5 {
		};

		pwm6 {
		};

		pwm7 {
		};

		pwr {
		};

		ref {
		};

		rgmii {

			rgmii-miim {
				rockchip,pins = <0x03 0x0e 0x02 0x0f 0x03 0x0f 0x02 0x0f>;
				phandle = <0x29>;
			};

			rgmii-rx_bus2 {
				rockchip,pins = <0x03 0x03 0x02 0x0d 0x03 0x02 0x02 0x0d 0x03 0x12 0x02 0x0d>;
				phandle = <0x2b>;
			};

			rgmii-tx_bus2 {
				rockchip,pins = <0x03 0x01 0x02 0x0f 0x03 0x00 0x02 0x0f 0x03 0x10 0x02 0x0d>;
				phandle = <0x2a>;
			};

			rgmii-rgmii_clk {
				rockchip,pins = <0x03 0x05 0x02 0x0d 0x03 0x04 0x02 0x0f>;
				phandle = <0x2c>;
			};

			rgmii-rgmii_bus {
				rockchip,pins = <0x03 0x07 0x02 0x0d 0x03 0x06 0x02 0x0d 0x03 0x09 0x02 0x0f 0x03 0x08 0x02 0x0f>;
				phandle = <0x2d>;
			};
		};

		scr {
		};

		sdio0 {

			sdio0-bus4 {
				rockchip,pins = <0x01 0x00 0x01 0x0e 0x01 0x01 0x01 0x0e 0x01 0x02 0x01 0x0e 0x01 0x03 0x01 0x0e>;
				phandle = <0x34>;
			};

			sdio0-clk {
				rockchip,pins = <0x01 0x05 0x01 0x0e>;
				phandle = <0x35>;
			};

			sdio0-cmd {
				rockchip,pins = <0x01 0x04 0x01 0x0e>;
				phandle = <0x36>;
			};
		};

		sdio1 {

			sdio1-bus4 {
				rockchip,pins = <0x03 0x06 0x01 0x0e 0x03 0x07 0x01 0x0e 0x03 0x08 0x01 0x0e 0x03 0x09 0x01 0x0e>;
				phandle = <0x37>;
			};

			sdio1-clk {
				rockchip,pins = <0x03 0x04 0x01 0x0e>;
				phandle = <0x38>;
			};

			sdio1-cmd {
				rockchip,pins = <0x03 0x05 0x01 0x0e>;
				phandle = <0x39>;
			};
		};

		sdmmc {

			sdmmc-bus4 {
				rockchip,pins = <0x02 0x00 0x01 0x0e 0x02 0x01 0x01 0x0e 0x02 0x02 0x01 0x0e 0x02 0x03 0x01 0x0e>;
				phandle = <0x3a>;
			};

			sdmmc-clk {
				rockchip,pins = <0x02 0x05 0x01 0x0e>;
				phandle = <0x3b>;
			};

			sdmmc-cmd {
				rockchip,pins = <0x02 0x04 0x01 0x0e>;
				phandle = <0x3c>;
			};

			sdmmc-det {
				rockchip,pins = <0x02 0x06 0x01 0x11>;
				phandle = <0x3d>;
			};
		};

		spdif {
		};

		spi0 {
		};

		spi1 {
		};

